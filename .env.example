# Optional. The app ships with the production API baked in:
#   https://archschool.vidxsepehr.ir/api
#
# For a development build talking to a LAN backend, copy this file to `.env`
# and point it at the machine running FastAPI. The WebSocket URL is derived
# automatically (http -> ws, same host, /api/ws).
#
# EXPO_PUBLIC_API_URL=http://192.168.1.20:8000/api
EXPO_PUBLIC_API_URL=https://archschool.vidxsepehr.ir/api
